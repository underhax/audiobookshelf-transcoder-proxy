# Audiobookshelf Transcoder Proxy (abstp) - Environment Configuration

# 1. Target Audiobookshelf instance base URL (required, without trailing slash)
# Examples: https://abs.example.org or http://192.168.1.100:13378
ABSTP_ABS_URL=https://abs.example.org

# 2. Authentication Secrets (Fallback only - Docker Secrets in ./secrets/ are used by default)
# Uncomment ONLY if running without Docker Secrets:
# ABSTP_ABS_TOKEN=your_audiobookshelf_api_token_here
# ABSTP_API_KEY=your_proxy_secret_key_here

# 3. External base URL override (Optional)
# By default, abstp automatically infers the base URL from incoming client requests (e.g. Host or X-Forwarded-Host headers).
# Uncomment ONLY if you need to enforce a fixed stream URL:
# - When running behind a reverse proxy with SSL:
#     ABSTP_EXTERNAL_URL=https://abstp.example.org
# - When accessing directly via host IP and custom port (replace 192.168.1.50 with your server IP):
#     ABSTP_EXTERNAL_URL=http://192.168.1.50:9099

# 4. Validity duration for single-use playback stream tokens (default: 30s)
# ABSTP_TOKEN_TTL=30s

# 5. Initial stream burst buffer duration to prime player buffers rapidly (default: 10s, minimum: 5s)
# ABSTP_BUFFER_DURATION=10s

# 6. Global maximum concurrent incoming HTTP connections (default: 100, range: 50-1000)
# ABSTP_MAX_CONNS=100

# 7. Maximum concurrent active FFmpeg transcoding streams (default: 5, range: 1-20)
# ABSTP_MAX_STREAMS=5
